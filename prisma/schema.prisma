generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
 
}

///////////////////////////////////////////////////////
//////////////////// ENUMS ////////////////////////////
///////////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  INVENTORY
}

enum OtpPurpose {
  REGISTER
  LOGIN
  CHANGE_PASSWORD
}

///////////////////////////////////////////////////////
//////////////// RESTAURANTS //////////////////////////
///////////////////////////////////////////////////////

model Restaurant {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  phone       String?  @db.VarChar(15)
  email       String?  @db.VarChar(150)
  address     String?  @db.VarChar(255)

  is_active   Boolean  @default(true)

  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @updatedAt @db.Timestamptz()

  /////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////

  users User[]

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@index([is_active])
  @@map("restaurants")
}

///////////////////////////////////////////////////////
//////////////////// USERS ////////////////////////////
///////////////////////////////////////////////////////

model User {
  id            Int      @id @default(autoincrement())

  restaurant_id Int?

  name          String   @db.VarChar(100)
  email         String?  @unique @db.VarChar(150)
  phone         String?  @unique @db.VarChar(15)

  password_hash String   @db.Char(60)

  role          Role     @default(WAITER)

  avatar        String?  @db.VarChar(255)

  is_active     Boolean  @default(true)

  last_login_at DateTime? @db.Timestamptz()

  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @updatedAt @db.Timestamptz()

  /////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////

  restaurant Restaurant? @relation(fields: [restaurant_id], references: [id])

  refresh_tokens RefreshToken[]
  otp_verifications OtpVerification[]

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@index([restaurant_id])
  @@index([role])
  @@index([is_active])

  @@map("users")
}

///////////////////////////////////////////////////////
//////////////// REFRESH TOKENS ///////////////////////
///////////////////////////////////////////////////////

model RefreshToken {
  id          Int      @id @default(autoincrement())

  user_id     Int

  token_hash  String   @unique @db.Char(64)

  device_info String?  @db.VarChar(255)
  ip_address  String?  @db.VarChar(45)

  expires_at  DateTime @db.Timestamptz()
  created_at  DateTime @default(now()) @db.Timestamptz()

  /////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@index([user_id, expires_at])

  @@map("refresh_tokens")
}

///////////////////////////////////////////////////////
//////////////// OTP VERIFICATIONS ////////////////////
///////////////////////////////////////////////////////

model OtpVerification {
  id         Int        @id @default(autoincrement())

  user_id    Int?

  contact    String     @db.VarChar(150)

  otp_hash   String     @db.Char(64)

  purpose    OtpPurpose

  attempts   Int        @default(0) @db.SmallInt

  is_used    Boolean    @default(false)

  expires_at DateTime   @db.Timestamptz()
  created_at DateTime   @default(now()) @db.Timestamptz()

  /////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@index([contact, purpose])
  @@index([expires_at])

  @@map("otp_verifications")
}